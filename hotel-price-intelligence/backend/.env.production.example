# Copy thành backend/.env trên server, KHÔNG commit file thật vào git.
DB_HOST=mysql
DB_PORT=3306
DB_NAME=hotel_price_intel
DB_USER=root
DB_PASSWORD=change_me_strong_password

DB_POOL_SIZE=5

CORS_ORIGINS=https://hotel.projecthub.io.vn

APP_TITLE=Hotel Price Intelligence API
APP_VERSION=1.0.0

UPLOAD_DIR=./uploaded_files
ARTIFACT_DIR=./crawl_artifacts
DEFAULT_HOTEL_LIST_PATH=./default_hotel_list.xlsx

DEFAULT_STAY_NIGHTS=1
DEFAULT_LEAD_TIME_BUCKETS=1,3,7,14,30,60
STALE_RUN_MINUTES=120

# Proxy VN cho Selenium (xem DEPLOYMENT.md muc 4) - de trong = khong dung proxy.
# PROXY_SERVER dang host:port (khong ghi scheme). Bo trong neu proxy khong yeu cau auth.
PROXY_SERVER=
PROXY_USERNAME=
PROXY_PASSWORD=
