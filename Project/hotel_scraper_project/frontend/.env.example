# ==============================================
# FRONTEND API CONFIGURATION
# ==============================================

# Local Development
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000

# Production - With HTTPS (Recommended)
# VITE_API_URL=https://your-domain.com/api
# VITE_WS_URL=wss://your-domain.com

# Production - Without SSL (HTTP only)
# VITE_API_URL=http://your-domain.com/api
# VITE_WS_URL=ws://your-domain.com

# ==============================================
# IMPORTANT NOTES:
# ==============================================
# 1. Copy this file to .env: cp .env.example .env
# 2. For local development, keep the default localhost config
# 3. For production with SSL: Use https:// for API and wss:// for WebSocket
# 4. For production without SSL: Use http:// for API and ws:// for WebSocket
# 5. CRITICAL: VITE_WS_URL should NOT include /api suffix
#    - Correct: wss://your-domain.com (WebSocket path /ws/scrape is auto-appended)
#    - Wrong: wss://your-domain.com/api (would create /api/ws/scrape)
# 6. This .env file is used during Docker build process
# 7. Never commit .env file to git
